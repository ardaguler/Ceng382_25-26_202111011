@page
@* Model direktifinin doğru IndexModel'i gösterdiğinden emin ol *@
@model Week8Lab.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Class Management - Week 9 DB"; // Başlık güncellendi
}

@* CDN linkleri ve style kısmı *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
<style>
    th.selectable-column { cursor: pointer; user-select: none; position: relative; }
    th.selectable-column.column-selected { background-color: #0d6efd; color: white; }
    th.selectable-column.column-selected::after { content: ' \2713'; font-size: 0.8em; }
</style>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4 mb-4">
            @* Ekleme/Düzenleme Formu *@
            <h4>@(Model.IsEditing ? "Edit Class" : "Add Class")</h4>
            <form method="post" asp-page-handler="Add">
                <input type="hidden" asp-for="ClassItem.Id" />
                <input type="hidden" asp-for="IsEditing" />
                <div class="mb-3">
                    <label asp-for="ClassItem.Name" class="form-label">Class Name</label>
                    <input asp-for="ClassItem.Name" class="form-control" />
                    <span asp-validation-for="ClassItem.Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ClassItem.PersonCount" class="form-label">Student Count</label>
                    <input type="number" asp-for="ClassItem.PersonCount" class="form-control" />
                    <span asp-validation-for="ClassItem.PersonCount" class="text-danger"></span>
                </div>
                 <div class="mb-3">
                    <label asp-for="ClassItem.Description" class="form-label">Description</label>
                    <textarea asp-for="ClassItem.Description" class="form-control" rows="3"></textarea>
                     <span asp-validation-for="ClassItem.Description" class="text-danger"></span>
                </div>
                @* IsActive alanı kullanıcı arayüzünden kaldırıldı *@
                <button type="submit" class="btn btn-success">
                    @(Model.IsEditing ? "Update Class" : "Add Class")
                </button>
                @if (Model.IsEditing)
                {
                    <a asp-page="/Index" asp-route-currentPage="@Model.CurrentPage" asp-route-SearchClassName="@Model.SearchClassName" asp-route-MinStudentCount="@Model.MinStudentCount" asp-route-MaxStudentCount="@Model.MaxStudentCount" class="btn btn-secondary">Cancel Edit</a>
                }
            </form>
        </div>

        <div class="col-md-8">
            @* Filtreleme Formu *@
            <h4>Filter Classes</h4>
            <form method="get" class="row g-3 mb-3 p-3 border rounded bg-light">
                 <div class="col-md-4">
                    <label asp-for="SearchClassName" class="form-label" style="color: black;">Class Name Contains</label>
                    <input asp-for="SearchClassName" class="form-control form-control-sm" id="SearchClassName" />
                </div>
                <div class="col-md-3">
                    <label asp-for="MinStudentCount" class="form-label" style="color: black;">Min Students</label>
                    <input type="number" asp-for="MinStudentCount" class="form-control form-control-sm" id="MinStudentCount" />
                </div>
                <div class="col-md-3">
                    <label asp-for="MaxStudentCount" class="form-label" style="color: black;">Max Students</label>
                    <input type="number" asp-for="MaxStudentCount" class="form-control form-control-sm" id="MaxStudentCount" />
                </div>
                <div class="col-md-2 align-self-end">
                    <button type="submit" class="btn btn-info btn-sm w-100">Filter</button>
                </div>
            </form>

            @* Export Butonları *@
            <div class="mb-3 d-flex flex-wrap gap-2">
                 <button id="exportFilteredJsonBtn" type="button" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-file-earmark-code"></i> Export Filtered (JSON)
                </button>
                <button id="exportAllJsonBtn" type="button" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-file-earmark-code-fill"></i> Export All (JSON)
                </button>
            </div>

            <h4>Class List</h4>
            @* Hata/Bilgi Mesajları *@
            @if (TempData["SuccessMessage"] != null)
            {
                 <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
             @if (TempData["ErrorMessage"] != null)
            {
                 <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ExportError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ExportError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @* Tablo Gösterimi *@
            @if (!Model.DisplayedClassList.Any() && Model.TotalCount > 0)
            {
                 <div class="alert alert-warning">No classes found on this page. Try page 1?</div>
            }
             else if (!Model.DisplayedClassList.Any())
             {
                  <div class="alert alert-info">No classes found matching the filter criteria.</div>
             }
             else
             {
                <table class="table table-bordered table-hover table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th class="selectable-column" data-column-name="Name">Class Name</th>
                            <th class="selectable-column" data-column-name="PersonCount">Student Count</th>
                            <th class="selectable-column" data-column-name="Description">Description</th>
                            @* IsActive sütun başlığı kullanıcı arayüzünden kaldırıldı *@
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DisplayedClassList)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.PersonCount</td>
                                <td>@item.Description</td>
                                @* IsActive sütun değeri kullanıcı arayüzünden kaldırıldı *@
                                <td class="d-flex gap-2 flex-wrap">
                                    @* Edit Formu *@
                                    <form method="post" asp-page-handler="Edit" asp-route-id="@item.Id" style="display:inline;">
                                        <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                                        <input type="hidden" name="SearchClassName" value="@Model.SearchClassName" />
                                        <input type="hidden" name="MinStudentCount" value="@Model.MinStudentCount" />
                                        <input type="hidden" name="MaxStudentCount" value="@Model.MaxStudentCount" />
                                        <button type="submit" class="btn btn-sm btn-warning p-1" title="Edit">
                                            <img src="~/images/icons8-edit.svg" alt="Edit" width="20" height="20" />
                                        </button>
                                    </form>
                                    @* Delete Formu *@
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline;">
                                        <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                                        <input type="hidden" name="SearchClassName" value="@Model.SearchClassName" />
                                        <input type="hidden" name="MinStudentCount" value="@Model.MinStudentCount" />
                                        <input type="hidden" name="MaxStudentCount" value="@Model.MaxStudentCount" />
                                        <button type="submit" class="btn btn-sm btn-danger p-1" title="Delete" onclick="return confirm('Are you sure you want to delete the class \'@(item.Name?.Replace("'", "\\'"))\'?');">
                                            <img src="~/images/icons8-delete.svg" alt="Delete" width="20" height="20" />
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
             } @* End of else block for table display *@

            @* --- DÜZELTİLMİŞ SAYFALAMA BÖLÜMÜ --- *@
            @if(Model.TotalPages > 1) @* Koşul > 1 olarak düzeltildi *@
            {
                <nav aria-label="Page navigation" data-current-page="@Model.CurrentPage">
                    <ul class="pagination justify-content-center">
                        @* Previous Button *@
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            @* Filtre parametreleri de linke eklendi *@
                            <a class="page-link" asp-page="/Index"
                               asp-route-currentPage="@(Model.CurrentPage - 1)"
                               asp-route-SearchClassName="@Model.SearchClassName"
                               asp-route-MinStudentCount="@Model.MinStudentCount"
                               asp-route-MaxStudentCount="@Model.MaxStudentCount">Previous</a>
                        </li>

                        @* Page Numbers *@
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                @* Filtre parametreleri de linke eklendi *@
                                <a class="page-link" asp-page="/Index"
                                   asp-route-currentPage="@i"
                                   asp-route-SearchClassName="@Model.SearchClassName"
                                   asp-route-MinStudentCount="@Model.MinStudentCount"
                                   asp-route-MaxStudentCount="@Model.MaxStudentCount">@i</a>
                            </li>
                        }

                        @* Next Button *@
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                             @* Filtre parametreleri de linke eklendi *@
                            <a class="page-link" asp-page="/Index"
                               asp-route-currentPage="@(Model.CurrentPage + 1)"
                               asp-route-SearchClassName="@Model.SearchClassName"
                               asp-route-MinStudentCount="@Model.MinStudentCount"
                               asp-route-MaxStudentCount="@Model.MaxStudentCount">Next</a>
                        </li>
                    </ul>
                </nav>
                @* Sayfa bilgisi gösterimi *@
                <div class="text-center text-white bg-dark p-2">
                    Page @Model.CurrentPage / @Model.TotalPages (Total Matching Classes: @Model.TotalCount)
                </div>
            }
            @* --- SAYFALAMA BÖLÜMÜ SONU --- *@

        </div> @* col-md-8 sonu *@
    </div> @* row sonu *@
</div> @* container sonu *@

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* JavaScript for Column Selection and Export *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Get references to UI elements
            const selectableColumns = document.querySelectorAll('th.selectable-column');
            const exportFilteredBtn = document.getElementById('exportFilteredJsonBtn');
            const exportAllBtn = document.getElementById('exportAllJsonBtn');
            const paginationNav = document.querySelector('nav[aria-label="Page navigation"]');

            // --- Column Selection Logic ---
            selectableColumns.forEach(th => {
                th.addEventListener('click', function () {
                    this.classList.toggle('column-selected');
                });
            });

            // --- Unified Export Button Logic ---
            function handleExport(exportMode) {
                // 1. Get selected columns (using updated data-column-name attributes)
                const selectedThs = document.querySelectorAll('th.selectable-column.column-selected');
                const selectedColumns = Array.from(selectedThs).map(th => th.getAttribute('data-column-name'));

                // 2. Get current filter values
                const searchClassName = document.getElementById('SearchClassName')?.value || '';
                const minStudentCount = document.getElementById('MinStudentCount')?.value || '';
                const maxStudentCount = document.getElementById('MaxStudentCount')?.value || '';

                // 3. Get current page number (for potential 'currentPage' export)
                const currentPageNum = paginationNav?.dataset.currentPage || '1';

                // 4. Construct the URL for the backend handler
                const url = new URL('@Url.Page("/Index", "ExportJson")', window.location.origin);
                url.searchParams.append('exportMode', exportMode);

                // Append filter values (needed by 'filtered' and 'currentPage' modes)
                url.searchParams.append('searchClassName', searchClassName);
                url.searchParams.append('minStudentCount', minStudentCount);
                url.searchParams.append('maxStudentCount', maxStudentCount);

                // Append selected columns (if any)
                 if (selectedColumns.length > 0) {
                    selectedColumns.forEach(col => {
                        if(col) { url.searchParams.append('selectedColumns', col); }
                    });
                 }

                // Append current page number ONLY if exporting current page
                if (exportMode === 'currentPage') {
                    url.searchParams.append('currentPage', currentPageNum);
                }

                // 5. Trigger the download
                console.log("Requesting Export URL:", url.toString());
                window.location.href = url.toString();
            }

            // Add event listeners to export buttons
            if (exportFilteredBtn) {
                exportFilteredBtn.addEventListener('click', function () {
                    handleExport('filtered');
                });
            }
            if (exportAllBtn) {
                exportAllBtn.addEventListener('click', function () {
                    handleExport('all');
                });
            }
        });
    </script>
    @* Include Bootstrap JS bundle *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
}