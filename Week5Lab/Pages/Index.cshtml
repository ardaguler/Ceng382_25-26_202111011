@page
@model Week5Lab.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Class Management";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />

<div class="container mt-5">
    <div class="row">
        <!-- Form Section -->
        <div class="col-md-4">
            <h4>Add or Edit Class</h4>
            <form method="post" asp-page-handler="Add">
                <input type="hidden" asp-for="ClassItem.Id" />
                <input type="hidden" asp-for="IsEditing" />
                <div class="mb-3">
                    <label asp-for="ClassItem.ClassName" class="form-label"></label>
                    <input asp-for="ClassItem.ClassName" class="form-control" />
                    <span asp-validation-for="ClassItem.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ClassItem.StudentCount" class="form-label"></label>
                    <input asp-for="ClassItem.StudentCount" class="form-control" />
                    <span asp-validation-for="ClassItem.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ClassItem.Description" class="form-label"></label>
                    <textarea asp-for="ClassItem.Description" class="form-control"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">
                    @(Model.IsEditing ? "Edit" : "Save")
                </button>

            </form>
        </div>

        <!-- Table Section -->
        <div class="col-md-8">
            <h4>Class List</h4>
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ClassList)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td class="d-flex gap-2">
                                <form method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-warning p-1" asp-page-handler="Edit" title="Edit">
                                        <img src="~/images/icons8-edit.svg" alt="Edit" width="20" height="20" />
                                    </button>
                                </form>

                                <form method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger p-1" asp-page-handler="Delete" title="Delete" onclick="return confirm('Are you sure?');">
                                        <img src="~/images/icons8-delete.svg" alt="Delete" width="20" height="20" />
                                    </button>
                                </form>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
