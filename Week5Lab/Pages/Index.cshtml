@page
@model Week5Lab.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Class Management - Week 6";
}

@* Using CDN links for simplicity, ensure you have internet access or use LibMan *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
@* Assuming icon images are in wwwroot/images *@

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4 mb-4">
            <h4>@(Model.IsEditing ? "Edit Class" : "Add Class")</h4>
            <form method="post" asp-page-handler="Add">
                @* Hidden input for the ID, crucial for updates *@
                <input type="hidden" asp-for="ClassItem.Id" />

                 @* Hidden fields to pass back current filter/page state IF the form submission fails validation
                     This helps retain the user's view context.
                     Alternatively, handle this purely in OnPostAdd by re-running OnGet after validation failure.
                     Let's keep it simple for now and rely on RedirectToPage after successful post.
                 *@
                @* <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                   <input type="hidden" name="SearchClassName" value="@Model.SearchClassName" />
                   <input type="hidden" name="MinStudentCount" value="@Model.MinStudentCount" />
                   <input type="hidden" name="MaxStudentCount" value="@Model.MaxStudentCount" /> *@


                <div class="mb-3">
                    <label asp-for="ClassItem.ClassName" class="form-label">Class Name</label>
                    <input asp-for="ClassItem.ClassName" class="form-control" />
                    <span asp-validation-for="ClassItem.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ClassItem.StudentCount" class="form-label">Student Count</label>
                    <input type="number" asp-for="ClassItem.StudentCount" class="form-control" />
                    <span asp-validation-for="ClassItem.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ClassItem.Description" class="form-label">Description</label>
                    <textarea asp-for="ClassItem.Description" class="form-control" rows="3"></textarea>
                    @* No validation needed for Description based on previous code, but you could add it *@
                </div>

                @* Submit button text changes based on IsEditing *@
                <button type="submit" class="btn btn-success">
                    @(Model.IsEditing ? "Update Class" : "Add Class")
                </button>

                @* Show Cancel button only when editing *@
                @if (Model.IsEditing)
                {
                    <a asp-page="/Index"
                       asp-route-currentPage="@Model.CurrentPage"
                       asp-route-SearchClassName="@Model.SearchClassName"
                       asp-route-MinStudentCount="@Model.MinStudentCount"
                       asp-route-MaxStudentCount="@Model.MaxStudentCount"
                       class="btn btn-secondary">Cancel Edit</a>
                }
            </form>
        </div>

        <div class="col-md-8">

            <h4>Filter Classes</h4>
            <form method="get" class="row g-3 mb-3 p-3 border rounded bg-light">
                <div class="col-md-4">
                    <label asp-for="SearchClassName" class="form-label" style="color: black;">Class Name Contains</label>
                    <input asp-for="SearchClassName" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label asp-for="MinStudentCount" class="form-label" style="color: black;">Min Students</label>
                    <input type="number" asp-for="MinStudentCount" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label asp-for="MaxStudentCount" class="form-label" style="color: black;">Max Students</label>
                    <input type="number" asp-for="MaxStudentCount" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2 align-self-end">
                    <button type="submit" class="btn btn-info btn-sm w-100">Filter</button>
                </div>
                 @* Hidden input to reset to page 1 when filter changes - optional but often desired *@
                 @* <input type="hidden" name="CurrentPage" value="1" /> *@
                 @* Or let the backend handle staying on the current page if possible *@

            </form>


            <h4>Class List</h4>
            @if (!Model.DisplayedClassList.Any() && Model.TotalCount > 0)
            {
                 <div class="alert alert-warning">No items found on this page. Maybe try page 1?</div>
            }
             else if (!Model.DisplayedClassList.Any())
             {
                  <div class="alert alert-info">No classes found matching the criteria.</div>
             }

             else
            {


            <table class="table table-bordered table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        @* <th>Id</th> NO ID COLUMN AS PER REQUIREMENT *@
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @* Loop through the FILTERED and PAGINATED list *@
                    @foreach (var item in Model.DisplayedClassList)
                    {
                        <tr>
                            @* <td>@item.Id</td> NO ID DATA *@
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td class="d-flex gap-2 flex-wrap">  @* Use flex-wrap for smaller screens *@

                                @* Edit Form (uses POST) *@
                                <form method="post" asp-page-handler="Edit" asp-route-id="@item.Id" style="display:inline;">
                                    @* Pass current view state back to the POST handler *@
                                    <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                                    <input type="hidden" name="SearchClassName" value="@Model.SearchClassName" />
                                    <input type="hidden" name="MinStudentCount" value="@Model.MinStudentCount" />
                                    <input type="hidden" name="MaxStudentCount" value="@Model.MaxStudentCount" />
                                    <button type="submit" class="btn btn-sm btn-warning p-1" title="Edit">
                                        <img src="~/images/icons8-edit.svg" alt="Edit" width="20" height="20" /> @* Ensure this path is correct *@
                                    </button>
                                </form>

                                @* Delete Form (uses POST) *@
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline;">
                                    @* Pass current view state back to the POST handler *@
                                    <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                                    <input type="hidden" name="SearchClassName" value="@Model.SearchClassName" />
                                    <input type="hidden" name="MinStudentCount" value="@Model.MinStudentCount" />
                                    <input type="hidden" name="MaxStudentCount" value="@Model.MaxStudentCount" />
                                    <button type="submit" class="btn btn-sm btn-danger p-1" title="Delete" onclick="return confirm('Are you sure you want to delete @(item.ClassName?.Replace("'", "\\'"))?');"> @* Added JS escaping for names with apostrophes *@
                                        <img src="~/images/icons8-delete.svg" alt="Delete" width="20" height="20" /> @* Ensure this path is correct *@
                                    </button>
                                </form>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

             } @* End of else block for table display *@

            @if(Model.TotalPages > 0)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">

                        @* Previous Button *@
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="/Index"
                               asp-route-currentPage="@(Model.CurrentPage - 1)"
                               asp-route-SearchClassName="@Model.SearchClassName"
                               asp-route-MinStudentCount="@Model.MinStudentCount"
                               asp-route-MaxStudentCount="@Model.MaxStudentCount">Previous</a>
                        </li>

                        @* Page Number Buttons (Example: show limited page numbers) *@
                        @* Basic: Show all pages *@
                         @for (int i = 1; i <= Model.TotalPages; i++)
                         {
                             <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                 <a class="page-link" asp-page="/Index"
                                    asp-route-currentPage="@i"
                                    asp-route-SearchClassName="@Model.SearchClassName"
                                    asp-route-MinStudentCount="@Model.MinStudentCount"
                                    asp-route-MaxStudentCount="@Model.MaxStudentCount">@i</a>
                             </li>
                         }
                        @* Add more sophisticated logic here for many pages (e.g., show first, last, current +/- 2) if needed *@


                        @* Next Button *@
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-page="/Index"
                               asp-route-currentPage="@(Model.CurrentPage + 1)"
                               asp-route-SearchClassName="@Model.SearchClassName"
                               asp-route-MinStudentCount="@Model.MinStudentCount"
                               asp-route-MaxStudentCount="@Model.MaxStudentCount">Next</a>
                        </li>
                    </ul>
                </nav>
                <div class="text-center text-white bg-dark p-2">
                    Page @Model.CurrentPage of @Model.TotalPages (Total matching classes: @Model.TotalCount)
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* Add Bootstrap JS if needed for any components, though not strictly required for this example *@
    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script> *@
}