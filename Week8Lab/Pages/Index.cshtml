@page
@* Model direktifinin doğru IndexModel'i gösterdiğinden emin ol (önceki adımda güncellediğimiz) *@
@model Week8Lab.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Class Management - Week 9 DB"; // <-- Başlığı güncelleyebilirsin
}

@* CDN linkleri ve style kısmı aynı kalabilir *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
<style>
    /* Style kısmı aynı kalabilir */
    th.selectable-column { cursor: pointer; user-select: none; position: relative; }
    th.selectable-column.column-selected { background-color: #0d6efd; color: white; }
    th.selectable-column.column-selected::after { content: ' \2713'; font-size: 0.8em; }
</style>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4 mb-4">
            <h4>@(Model.IsEditing ? "Edit Class" : "Add Class")</h4>
            @* Formun modeli ClassItem'ın türü Class olarak değiştirilmişti (arka planda) *@
            <form method="post" asp-page-handler="Add">
                <input type="hidden" asp-for="ClassItem.Id" />
                <div class="mb-3">
                     @* Label'ın asp-for'u Class modelindeki 'Name' olmalı *@
                    <label asp-for="ClassItem.Name" class="form-label">Class Name</label>
                    <input asp-for="ClassItem.Name" class="form-control" />
                    <span asp-validation-for="ClassItem.Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    @* Label'ın asp-for'u Class modelindeki 'PersonCount' olmalı *@
                    <label asp-for="ClassItem.PersonCount" class="form-label">Student Count</label>
                    <input type="number" asp-for="ClassItem.PersonCount" class="form-control" />
                    <span asp-validation-for="ClassItem.PersonCount" class="text-danger"></span>
                </div>
                 <div class="mb-3">
                     @* Label'ın asp-for'u Class modelindeki 'Description' olmalı *@
                    <label asp-for="ClassItem.Description" class="form-label">Description</label>
                    <textarea asp-for="ClassItem.Description" class="form-control" rows="3"></textarea>
                     <span asp-validation-for="ClassItem.Description" class="text-danger"></span> @* <- Açıklama için doğrulama eklenebilir *@
                </div>
                 @* IsActive alanı için bir Checkbox eklenebilir (Add/Edit formu için) *@
                 <div class="mb-3 form-check">
                     <input type="checkbox" class="form-check-input" asp-for="ClassItem.IsActive">
                     <label class="form-check-label" asp-for="ClassItem.IsActive">Is Active?</label>
                 </div>
                <button type="submit" class="btn btn-success">
                    @(Model.IsEditing ? "Update Class" : "Add Class")
                </button>
                @if (Model.IsEditing)
                {
                    <a asp-page="/Index" asp-route-currentPage="@Model.CurrentPage" asp-route-SearchClassName="@Model.SearchClassName" asp-route-MinStudentCount="@Model.MinStudentCount" asp-route-MaxStudentCount="@Model.MaxStudentCount" class="btn btn-secondary">Cancel Edit</a>
                }
            </form>
        </div>

        <div class="col-md-8">
            @* Filtreleme formu aynı kalabilir (arka plan kodu DB'ye göre güncellendi) *@
            <h4>Filter Classes</h4>
            <form method="get" class="row g-3 mb-3 p-3 border rounded bg-light">
                 <div class="col-md-4">
                    <label asp-for="SearchClassName" class="form-label" style="color: black;">Class Name Contains</label>
                    <input asp-for="SearchClassName" class="form-control form-control-sm" id="SearchClassName" />
                </div>
                <div class="col-md-3">
                    <label asp-for="MinStudentCount" class="form-label" style="color: black;">Min Students</label>
                    <input type="number" asp-for="MinStudentCount" class="form-control form-control-sm" id="MinStudentCount" />
                </div>
                <div class="col-md-3">
                    <label asp-for="MaxStudentCount" class="form-label" style="color: black;">Max Students</label>
                    <input type="number" asp-for="MaxStudentCount" class="form-control form-control-sm" id="MaxStudentCount" />
                </div>
                <div class="col-md-2 align-self-end">
                    <button type="submit" class="btn btn-info btn-sm w-100">Filter</button>
                </div>
            </form>

            @* Export butonları aynı kalabilir (arka plan kodu DB'ye göre güncellendi) *@
            <div class="mb-3 d-flex flex-wrap gap-2">
                 <button id="exportFilteredJsonBtn" type="button" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-file-earmark-code"></i> Export Filtered (JSON)
                </button>
                <button id="exportAllJsonBtn" type="button" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-file-earmark-code-fill"></i> Export All (JSON)
                </button>
            </div>

            <h4>Class List</h4>
            @* Hata mesajı kısmı aynı kalabilir *@
            @if (TempData["ExportError"] != null) { /* ... Hata mesajı ... */ }

            @* Uyarı mesajları aynı kalabilir *@
            @if (!Model.DisplayedClassList.Any() && Model.TotalCount > 0) { /* ... Uyarı ... */ }
            else if (!Model.DisplayedClassList.Any()) { /* ... Uyarı ... */ }
            else
            {
                <table class="table table-bordered table-hover table-striped">
                    <thead class="table-dark">
                        <tr>
                            @* Kolon başlıklarını Class modeline göre güncelleyelim *@
                            @* Id kolonunu istersen ekleyebilirsin: <th class="selectable-column" data-column-name="Id">ID</th> *@
                            <th class="selectable-column" data-column-name="Name">Class Name</th> @* <-- data-column-name güncellendi *@
                            <th class="selectable-column" data-column-name="PersonCount">Student Count</th> @* <-- data-column-name güncellendi *@
                            <th class="selectable-column" data-column-name="Description">Description</th>
                            <th class="selectable-column" data-column-name="IsActive">Is Active?</th> @* <-- Yeni başlık eklendi *@
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                         @* Döngüdeki 'item' artık 'Class' türünde *@
                        @foreach (var item in Model.DisplayedClassList)
                        {
                            <tr>
                                @* Id'yi göstermek istersen: <td>@item.Id</td> *@
                                <td>@item.Name</td> @* <-- ClassName yerine Name *@
                                <td>@item.PersonCount</td> @* <-- StudentCount yerine PersonCount *@
                                <td>@item.Description</td>
                                <td>@(item.IsActive ? "Yes" : "No")</td> @* <-- IsActive gösterimi eklendi *@
                                <td class="d-flex gap-2 flex-wrap">
                                    @* Edit/Delete formları item.Id kullandığı için aynı kalabilir *@
                                    <form method="post" asp-page-handler="Edit" asp-route-id="@item.Id" style="display:inline;">
                                        @* Hidden inputlar aynı kalabilir *@
                                        <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                                        <input type="hidden" name="SearchClassName" value="@Model.SearchClassName" />
                                        <input type="hidden" name="MinStudentCount" value="@Model.MinStudentCount" />
                                        <input type="hidden" name="MaxStudentCount" value="@Model.MaxStudentCount" />
                                        <button type="submit" class="btn btn-sm btn-warning p-1" title="Edit">
                                            <img src="~/images/icons8-edit.svg" alt="Edit" width="20" height="20" />
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline;">
                                         @* Hidden inputlar aynı kalabilir *@
                                        <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                                        <input type="hidden" name="SearchClassName" value="@Model.SearchClassName" />
                                        <input type="hidden" name="MinStudentCount" value="@Model.MinStudentCount" />
                                        <input type="hidden" name="MaxStudentCount" value="@Model.MaxStudentCount" />
                                         @* Onay mesajında item.Name kullanıldı *@
                                        <button type="submit" class="btn btn-sm btn-danger p-1" title="Delete" onclick="return confirm('Are you sure you want to delete the class \'@(item.Name?.Replace("'", "\\'"))\'?');">
                                            <img src="~/images/icons8-delete.svg" alt="Delete" width="20" height="20" />
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            } @* End of else block *@

            @* Pagination kısmı aynı kalabilir *@
            @if(Model.TotalPages > 0)
            {
                <nav aria-label="Page navigation" data-current-page="@Model.CurrentPage">
                   @* ... pagination links ... *@
                </nav>
                <div class="text-center text-white bg-dark p-2">
                    Page @Model.CurrentPage / @Model.TotalPages (Total Matching Classes: @Model.TotalCount)
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* JavaScript kısmı (column selection, export) aynı kalabilir,
        ANCAK data-column-name'lerin güncellendiğini unutma (Name, PersonCount, IsActive) *@
    <script>
        // ... mevcut javascript kodun ...
        // Export JS'indeki data-column-name'leri kontrol etmeyi unutma!
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
}